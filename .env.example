# Most fields are DEV-04a configuration DESIGN; full service loaders are not implemented.
# Current DEV-04b Alembic/bootstrap CLI reads only HMI_DATABASE_DSN from the process
# environment. It does not load this file or assemble the HMI_DB_* fields below.
# Supply the DSN securely at runtime; never commit its credential-bearing value.
HMI_DATABASE_DSN=
# Vercel api/index.py also reads this exact production HTTPS origin.
# Enter both values directly in Vercel; this template is not loaded automatically.
HMI_PUBLIC_ORIGIN=
# Optional server-only JSON credential array; omit until a gateway is configured.
# HMI_GATEWAY_CREDENTIALS_JSON=[]
# Relative paths resolve from repository root. Runtime outputs belong under .local/.
# Loopback HTTP is development only. Deployment requires HTTPS, secure cookies,
# explicit service DNS overrides, protected secret mounts, and trusted OPC certificates.
HMI_ENV=development
HMI_RUNTIME_DIR=.local
HMI_LOG_DIR=.local/logs
HMI_BACKUP_DIR=.local/backups
HMI_REPORT_TIMEZONE=Asia/Seoul

# Future host-process defaults: API 8000, web 5173, PostgreSQL 5432.
HMI_API_HOST=127.0.0.1
HMI_API_PORT=8000
HMI_API_BASE_URL=http://127.0.0.1:8000
HMI_WEB_HOST=127.0.0.1
HMI_WEB_PORT=5173
HMI_BROWSER_ORIGIN=http://127.0.0.1:5173
# Browser uses same-origin /api and /ws through the future dev/reverse proxy.
# Never inject DB, service, or OPC secrets into browser build variables.
HMI_BROWSER_API_PREFIX=/api

HMI_DB_HOST=127.0.0.1
HMI_DB_PORT=5432
HMI_DB_NAME=hmi_mes
HMI_DB_USER=hmi_api
HMI_DB_MIGRATION_USER=hmi_migrator
# REQUIRED by API: path to a protected file containing the DML account password.
HMI_DB_PASSWORD_FILE=
# REQUIRED only by explicit migration/bootstrap tooling, never the ordinary API.
HMI_DB_MIGRATION_PASSWORD_FILE=
# Development loopback only; deployment must use verify-full with a CA file.
HMI_DB_SSLMODE=disable
HMI_DB_SSLROOTCERT_FILE=

# Separate process-owned SQLite files. Never mount one app's DB into the other.
HMI_GATEWAY_ID=gateway-local
HMI_GATEWAY_DB_PATH=.local/gateway/buffer.sqlite3
HMI_SIMULATOR_DB_PATH=.local/simulator/state.sqlite3
HMI_SQLITE_BUSY_TIMEOUT_MS=5000
HMI_GATEWAY_POLL_INTERVAL_MS=1000
HMI_GATEWAY_BUFFER_MAX_AGE_SECONDS=1800
HMI_GATEWAY_BUFFER_MAX_BYTES=100000000
# Gateway has no inbound HTTP listener or port; it calls the API outbound.
HMI_GATEWAY_API_URL=http://127.0.0.1:8000
HMI_GATEWAY_SERVICE_KEY_ID=gateway-local-v1
# REQUIRED by API and gateway: protected file containing the same random bearer
# token (at least 256 bits); API stores its digest with source/line scopes.
HMI_GATEWAY_SERVICE_TOKEN_FILE=

# Browser sessions: false is allowed ONLY in development on loopback HTTP.
# Deployment must set true, serve HTTPS, and require CSRF + exact Origin checks.
HMI_SESSION_COOKIE_NAME=hmi_session
HMI_SESSION_COOKIE_SECURE=false
HMI_SESSION_IDLE_SECONDS=1800
HMI_SESSION_ABSOLUTE_SECONDS=28800
HMI_COMMAND_TTL_SECONDS=5
HMI_START_RESULT_WAIT_SECONDS=10
HMI_END_RUN_RESULT_WAIT_SECONDS=60

# App B console is a separate authenticated application; app A cookies/tokens
# grant no console access. It must enforce its own sessions, roles and CSRF.
HMI_SIMULATOR_CONSOLE_HOST=127.0.0.1
HMI_SIMULATOR_CONSOLE_PORT=8001
HMI_SIMULATOR_CONSOLE_ORIGIN=http://127.0.0.1:8001
HMI_SIMULATOR_COOKIE_NAME=hmi_simulator_session
HMI_SIMULATOR_COOKIE_SECURE=false
HMI_SIMULATOR_TICK_MS=100
HMI_SIMULATOR_TIME_SCALE=1

# OPC application identity and certificates are separate from HTTP service auth.
# Endpoint/ApplicationUri must match certificates. Namespace indexes are dynamic.
HMI_OPC_ENDPOINT=opc.tcp://127.0.0.1:4840/hmi-mes/
HMI_OPC_BIND_HOST=127.0.0.1
HMI_OPC_PORT=4840
HMI_OPC_SECURITY_POLICY=Basic256Sha256
HMI_OPC_SECURITY_MODE=SignAndEncrypt
HMI_OPC_SERVER_APPLICATION_URI=urn:hmi-mes:simulator
HMI_OPC_CLIENT_APPLICATION_URI=urn:hmi-mes:gateway
# These paths describe externally provisioned files/directories, not generated
# credentials. Missing/invalid keys or trust must fail startup; never auto-trust.
HMI_OPC_SERVER_CERT_PATH=.local/pki/simulator/own/cert.der
HMI_OPC_SERVER_KEY_PATH=.local/pki/simulator/own/key.pem
HMI_OPC_SERVER_TRUST_DIR=.local/pki/simulator/trusted
HMI_OPC_SERVER_REJECTED_DIR=.local/pki/simulator/rejected
HMI_OPC_CLIENT_CERT_PATH=.local/pki/gateway/own/cert.der
HMI_OPC_CLIENT_KEY_PATH=.local/pki/gateway/own/key.pem
HMI_OPC_CLIENT_TRUST_DIR=.local/pki/gateway/trusted
HMI_OPC_CLIENT_REJECTED_DIR=.local/pki/gateway/rejected

HMI_RAW_ANALOG_RETENTION_DAYS=7
HMI_MINUTE_AGGREGATE_RETENTION_DAYS=90
HMI_OPERATION_EVENT_RETENTION_DAYS=180
HMI_SIMULATOR_EVENT_RETENTION_DAYS=7
# Retention never overrides unresolved/incomplete record protection.

# Explicit one-time bootstrap only: BOTH login and protected password-file path
# are required for the selected app. Ordinary server startup creates no account.
# Remove these mounts after bootstrap; never commit actual secrets or .env.
HMI_BOOTSTRAP_ADMIN_LOGIN=
HMI_BOOTSTRAP_ADMIN_PASSWORD_FILE=
HMI_BOOTSTRAP_SIMULATOR_LOGIN=
HMI_BOOTSTRAP_SIMULATOR_PASSWORD_FILE=
