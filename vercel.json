{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm --prefix apps/web ci && VITE_SCREEN_TRANSPORT=polling npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{.local/**,.cache/**,.venv/**,tests/**,docs/**,deploy/**,apps/web/node_modules/**,apps/web/src/**,**/*.sqlite*,**/*.pem,**/*.der,**/*.log}"
    }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/index.py" },
    { "source": "/internal/:path*", "destination": "/api/index.py" },
    { "source": "/health/:path*", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" }
  ]
}
