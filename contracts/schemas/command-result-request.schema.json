{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "title": "Command Id",
      "type": "string"
    }
  },
  "required": [
    "command_id"
  ],
  "title": "CommandResultRequest",
  "type": "object"
}
