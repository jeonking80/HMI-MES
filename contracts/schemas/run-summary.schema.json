{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Parameters": {
      "additionalProperties": false,
      "properties": {
        "temperature_c": {
          "minimum": 0,
          "title": "Temperature C",
          "type": "number"
        },
        "speed_m_per_min": {
          "exclusiveMinimum": 0,
          "title": "Speed M Per Min",
          "type": "number"
        },
        "air_pressure_bar": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Air Pressure Bar"
        }
      },
      "required": [
        "temperature_c",
        "speed_m_per_min"
      ],
      "title": "Parameters",
      "type": "object"
    },
    "ParametersChangedEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Event Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Source Id",
          "type": "string"
        },
        "stream_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Stream Id",
          "type": "string"
        },
        "seq": {
          "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
          "title": "Seq",
          "type": "string"
        },
        "equipment_id": {
          "const": "Line",
          "title": "Equipment Id",
          "type": "string"
        },
        "execution_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Execution Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "kind": {
          "const": "PARAMETERS_CHANGED",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ParametersChangedPayload"
        }
      },
      "required": [
        "event_id",
        "source_id",
        "stream_id",
        "seq",
        "equipment_id",
        "execution_id",
        "occurred_at",
        "kind",
        "payload"
      ],
      "title": "ParametersChangedEvent",
      "type": "object"
    },
    "ParametersChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Command Id",
          "type": "string"
        },
        "requested_by": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Requested By",
          "type": "string"
        },
        "recipe_version": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Recipe Version",
          "type": "string"
        },
        "baseline_parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "previous_parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "control_version": {
          "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
          "title": "Control Version",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "requested_by",
        "recipe_version",
        "baseline_parameters",
        "previous_parameters",
        "parameters",
        "control_version"
      ],
      "title": "ParametersChangedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "title": "Source Id",
      "type": "string"
    },
    "stream_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "title": "Stream Id",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "title": "Execution Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "LOADED",
        "RUNNING",
        "PAUSED",
        "ENDING",
        "ENDED"
      ],
      "title": "State",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "counter_epoch": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "title": "Counter Epoch",
      "type": "string"
    },
    "recipe_version": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "title": "Recipe Version",
      "type": "string"
    },
    "parameters": {
      "$ref": "#/$defs/Parameters"
    },
    "input_quantity": {
      "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
      "title": "Input Quantity",
      "type": "string"
    },
    "good_quantity": {
      "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
      "title": "Good Quantity",
      "type": "string"
    },
    "reject_quantity": {
      "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
      "title": "Reject Quantity",
      "type": "string"
    },
    "scrap_quantity": {
      "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
      "title": "Scrap Quantity",
      "type": "string"
    },
    "wip_quantity": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Wip Quantity",
      "type": "integer"
    },
    "last_event_seq": {
      "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
      "title": "Last Event Seq",
      "type": "string"
    },
    "final": {
      "title": "Final",
      "type": "boolean"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "end_reason": {
      "anyOf": [
        {
          "enum": [
            "TARGET_REACHED",
            "OPERATOR"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Reason"
    },
    "baseline_parameters": {
      "anyOf": [
        {
          "$ref": "#/$defs/Parameters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameter_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParametersChangedEvent"
      },
      "title": "Parameter Changes",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "stream_id",
    "execution_id",
    "state",
    "as_of",
    "counter_epoch",
    "recipe_version",
    "parameters",
    "input_quantity",
    "good_quantity",
    "reject_quantity",
    "scrap_quantity",
    "wip_quantity",
    "last_event_seq",
    "final"
  ],
  "title": "RunSummary",
  "type": "object"
}
