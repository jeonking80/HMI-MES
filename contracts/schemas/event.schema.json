  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FaultEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Event Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Source Id",
          "type": "string"
        },
        "stream_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Stream Id",
          "type": "string"
        },
        "seq": {
          "description": "UInt64 canonical decimal string; use BigInt in JavaScript.",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
          "title": "Seq",
          "type": "string"
        },
        "equipment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "title": "Equipment Id",
          "type": "string"
        },
        "execution_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Id"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "kind": {
          "const": "FAULT_CHANGED",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/FaultPayload"
        }
      },
      "required": [
        "event_id",
        "source_id",
        "stream_id",
        "seq",
        "equipment_id",
        "execution_id",
        "occurred_at",
        "kind",
        "payload"
      ],
      "title": "FaultEvent",
      "type": "object"
    },
    "FaultPayload": {
      "additionalProperties": false,
      "properties": {
        "fault_code": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Fault Code",
          "type": "integer"
        },
        "active": {
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "fault_code",
        "active"
      ],
      "title": "FaultPayload",
      "type": "object"
    },
    "LineState": {
      "enum": [
        "STOPPED",
        "READY",
        "RUNNING",
        "PAUSED",
        "STOPPING",
        "FAULT",
        "ESTOP",
        "RECOVERY_REQUIRED"
      ],
      "title": "LineState",
      "type": "string"
    },
